{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": ["--extensionDevelopmentPath=${workspaceFolder}", "${workspaceFolder}/fixtures/multi_module"],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js", "${workspaceFolder}/server/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    },
    {
      "name": "Attach to Language Server",
      "type": "node",
      "request": "attach",
      "port": 6009,
      "restart": true,
      "outFiles": ["${workspaceFolder}/server/out/**/*.js"]
    },
    {
      "name": "Extension Tests",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensionTestsPath=${workspaceFolder}/test/integration/suite/index",
        "${workspaceFolder}/fixtures/multi_module"
      ],
      "outFiles": ["${workspaceFolder}/extension/out/**/*.js", "${workspaceFolder}/server/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ],
  "compounds": [
    {
      "name": "Extension + Server",
      "configurations": ["Run Extension", "Attach to Language Server"]
    }
  ]
}
