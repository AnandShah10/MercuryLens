{
  "comments": {
    "lineComment": "%",
    "blockComment": ["/*", "*/"]
  },
  "brackets": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"]
  ],
  "autoClosingPairs": [
    { "open": "(", "close": ")" },
    { "open": "[", "close": "]" },
    { "open": "{", "close": "}" },
    { "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
    { "open": "'", "close": "'", "notIn": ["string", "comment"] }
  ],
  "surroundingPairs": [
    ["(", ")"],
    ["[", "]"],
    ["{", "}"],
    ["\"", "\""],
    ["'", "'"]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\`\\~\\!\\@\\#\\%\\^\\&\\*\\(\\)\\-\\=\\+\\[\\{\\]\\}\\\\\\|\\;\\:\\'\\\"\\,\\.\\<\\>\\/\\?\\s]+)",
  "indentationRules": {
    "increaseIndentPattern": "^\\s*(:-\\s*(pred|func|mode|type|typeclass|instance)\\b.*[^.]|.*\\b(then|else|->)\\s*$|.*:-\\s*$|.*\\(\\s*$)",
    "decreaseIndentPattern": "^\\s*(else|then|\\)\\.|\\)\\s*\\.|\\bend_module\\b).*"
  },
  "folding": {
    "markers": {
      "start": "^\\s*%\\s*region\\b|^\\s*:-\\s*(pred|func)\\b",
      "end": "^\\s*%\\s*endregion\\b"
    }
  }
}
