{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "moduleResolution": "node",
    "lib": ["ES2020"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node", "mocha"]
  },
  "include": ["test/**/*.ts", "server/src/**/*.ts", "extension/src/**/*.ts"],
  "exclude": ["node_modules", "extension/out", "server/out"]
}
